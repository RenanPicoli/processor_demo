    { "name": "IRQ_IN[0]", "wave": "00111111000000000000" },
    { "name": "IRQ_IN_prev[0]", "wave": "00011111100000000000" },
    { "name": "IRQ_pend[0]", "wave": "00011111100000000000" },
    { "name": "IRQ_OUT (OR dos pendentes)", "wave": "00011111100000000000" },
    {},
    { "name": "RDEN (leitura do pendente)", "wave": "00000110000000000000" },
    { "name": "WREN (limpa IRQ_pend[0])", "wave": "00000000100000000000" },
    { "name": "ADDR", "wave": "xxxxx=xx=xxxxxxxxxxx", "data": ["00: leitura", "00: escrita"] },
